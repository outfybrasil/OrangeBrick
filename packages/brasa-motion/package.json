{
  "name": "@brasa/motion",
  "version": "0.2.0",
  "description": "Motor pessoal de v\u00eddeos editoriais com cenas sem\u00e2nticas e renderiza\u00e7\u00e3o local",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./runtime.d.ts",
      "import": "./runtime.mjs"
    },
    "./music": {
      "types": "./music.d.ts",
      "import": "./music.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "assets",
    "runtime.mjs",
    "runtime.d.ts",
    "music.mjs",
    "music.d.ts",
    "tsconfig.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "gsap": "3.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5"
  }
}
