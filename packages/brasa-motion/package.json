{
  "name": "@brasa/motion",
  "version": "0.4.0",
  "description": "Motor pessoal de vídeos editoriais verticais e horizontais com cenas semânticas e renderização local",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./runtime.d.ts",
      "import": "./runtime.mjs"
    },
    "./music": {
      "types": "./music.d.ts",
      "import": "./music.mjs"
    },
    "./sfx": {
      "types": "./sfx.d.ts",
      "import": "./sfx.mjs"
    },
    "./study": {
      "types": "./study.d.ts",
      "import": "./study.mjs"
    },
    "./landscape": {
      "types": "./landscape.d.ts",
      "import": "./landscape.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "assets",
    "runtime.mjs",
    "runtime.d.ts",
    "music.mjs",
    "music.d.ts",
    "sfx.mjs",
    "sfx.d.ts",
    "study.mjs",
    "study.d.ts",
    "tsconfig.json",
    "THIRD_PARTY_NOTICES.md",
    "landscape.mjs",
    "landscape.d.ts",
    "creator.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "gsap": "3.14.2"
  },
  "peerDependencies": {
    "playwright": ">=1.50",
    "sharp": ">=0.33"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5"
  }
}
