# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
client_secret_*.json
/scripts/.drive-sync-state.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
