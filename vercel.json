{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/release-radar-cleanup",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/daily-poll",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/generate-daily?slot=11",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/generate-daily?slot=17",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/generate-daily?slot=20",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/editorial-scheduler",
      "schedule": "0 14 * * *"
    }
  ]
}
