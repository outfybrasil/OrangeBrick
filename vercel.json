{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/release-radar-cleanup",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/drive-sync",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/daily-poll",
      "schedule": "0 10 * * *"
    },
{
      "path": "/api/cron/generate-daily",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/editorial-scheduler",
      "schedule": "*/10 * * * *"
    }
  ]
}
