{
  "name": "orange-brick",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "e2e": "playwright test",
    "textcheck": "node scripts/check-text-integrity.mjs",
    "check": "npm run textcheck && npm run lint && npm run typecheck && npm test && npm run build",
    "admin:create": "node scripts/create-admin.mjs",
    "images:migrate": "node --env-file=.env.local scripts/migrate-editorial-images.mjs && node --env-file=.env.local scripts/migrate-site-images.mjs",
    "backup:create": "node --env-file=.env.local scripts/backup-supabase.mjs",
    "backup:keygen": "node scripts/generate-backup-key.mjs",
    "backup:verify": "node --env-file=.env.local scripts/verify-backup.mjs",
    "production:check": "node --env-file=.env.local scripts/check-production-readiness.mjs",
    "scan-news": "node scripts/scan-news.mjs",
    "news:generate": "node --experimental-strip-types --env-file=.env.local scripts/generate-news.mjs",
    "news:daily": "node --experimental-strip-types --env-file=.env.local scripts/generate-news.mjs",
    "telegram:setup": "node --env-file=.env.local scripts/setup-telegram-webhook.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@google/genai": "^2.17.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@vercel/functions": "^3.9.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.29.0",
    "motion": "^13.1.0",
    "next": "^16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.6",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.4",
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.9",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18"
  }
}
